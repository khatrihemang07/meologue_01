{
  "openapi": "3.1.0",
  "info": {
    "title": "meologue-server",
    "description": "",
    "license": {
      "name": ""
    },
    "version": "0.1.0"
  },
  "paths": {
    "/v1/health": {
      "get": {
        "tags": [
          "crate::health"
        ],
        "summary": "Answers whether an address is actually a meologue Server, and which\nprotocol it speaks — without touching the database, so a Server whose\nPostgres is down still identifies itself. Unlike `/v1/sync`, this never\nrejects on protocol version: its whole job is letting the caller compare\nversions themselves. See ADR 0010.",
        "operationId": "health_handler",
        "responses": {
          "200": {
            "description": "This address is a meologue Server speaking protocol_version",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/sync": {
      "post": {
        "tags": [
          "crate::sync"
        ],
        "operationId": "sync_handler",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SyncRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Entries accepted; every Entry after since_seq is returned",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncResponse"
                }
              }
            }
          },
          "426": {
            "description": "protocol_version is not one this server understands"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "EntryInput": {
        "type": "object",
        "required": [
          "id",
          "device_id",
          "body",
          "created_at"
        ],
        "properties": {
          "body": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "device_id": {
            "type": "string",
            "format": "uuid"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "EntryOutput": {
        "type": "object",
        "required": [
          "id",
          "device_id",
          "body",
          "created_at",
          "seq"
        ],
        "properties": {
          "body": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "device_id": {
            "type": "string",
            "format": "uuid"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "seq": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "HealthResponse": {
        "type": "object",
        "required": [
          "service",
          "protocol_version"
        ],
        "properties": {
          "protocol_version": {
            "type": "integer",
            "format": "int32"
          },
          "service": {
            "type": "string"
          }
        }
      },
      "SyncRequest": {
        "type": "object",
        "required": [
          "protocol_version",
          "device_id",
          "since_seq",
          "entries"
        ],
        "properties": {
          "device_id": {
            "type": "string",
            "format": "uuid"
          },
          "entries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EntryInput"
            }
          },
          "protocol_version": {
            "type": "integer",
            "format": "int32"
          },
          "since_seq": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "SyncResponse": {
        "type": "object",
        "required": [
          "entries",
          "cursor"
        ],
        "properties": {
          "cursor": {
            "type": "integer",
            "format": "int64"
          },
          "entries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EntryOutput"
            }
          }
        }
      }
    }
  }
}
