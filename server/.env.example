MEOLOGUE_CHAT_BASE_URL=
MEOLOGUE_CHAT_MODEL=
MEOLOGUE_CHAT_API_KEY=
MEOLOGUE_EMBED_BASE_URL=
MEOLOGUE_EMBED_MODEL=
MEOLOGUE_EMBED_API_KEY=
MEOLOGUE_TZ=

# production or sandbox — defaults to production when unset. Names this
# instance (startup banner today; a UI banner or log prefix later) and
# decides nothing else — it does not affect the settings precedence below.
# See docs/adr/0062-*.
MEOLOGUE_MODE=

# NOT a variable to copy a value into. Any non-empty value makes this
# Server ignore its stored settings (docs/adr/0059-*) entirely and read
# only the environment above — scripts/e2e-server.sh and
# scripts/e2e-server-b.sh set this themselves, so the persistent e2e
# databases can't poison a suite run with a settings row left over from a
# previous one. Leave this unset in your own server/.env.
MEOLOGUE_CONFIG_LOCK=

# Defaults to 0.0.0.0 — that non-loopback interface is what lets Tailscale
# reach this server. Set BIND=127.0.0.1 to restrict it to this machine only.
# There is no authentication at any bind address (docs/adr/0003); BIND is the
# one lever for narrowing who can reach it.
BIND=
