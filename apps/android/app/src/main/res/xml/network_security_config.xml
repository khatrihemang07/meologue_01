<?xml version="1.0" encoding="utf-8"?>
<!--
  Android blocks cleartext traffic by default (targetSdkVersion 28+). The Server URL
  (ticket 26) is typed at runtime and can be any address on the user's network, so no
  static allowlist of hosts can anticipate it — cleartext is permitted base-wide rather
  than to one hardcoded host. The server has no certificate to offer (ADR 0003: trust is
  network-level, not transport-level), so `http` cleartext is the only way this app ever
  reaches it.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
