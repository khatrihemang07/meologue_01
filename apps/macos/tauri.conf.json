{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "meologue",
  "version": "0.2.0",
  "identifier": "com.meologue.app",
  "build": {
    "frontendDist": "../web/dist/macos"
  },
  "app": {
    "windows": [
      {
        "title": "meologue",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "meologue Dev"
    }
  }
}
