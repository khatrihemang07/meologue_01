<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Issue #454. The built .app is signed with the hardened runtime (codesign reports
  flags=0x10000(runtime)), and under the hardened runtime macOS only lets a process capture
  audio if it carries this entitlement; without it getUserMedia fails silently or the
  permission prompt never appears. Referenced from tauri.conf.json's bundle.macOS.entitlements
  (tauri.sandbox.conf.json merges over that file, so the Sandbox build inherits it).
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
